# Tahta Kumanda ayarları
#
# Bir ayarı değiştirmek için satırın başındaki # işaretini kaldırıp değeri yazın.
# Ayar dosyaları şu sırayla okunur (sonraki öncekini ezer):
#   /etc/tahta-kumanda/ayarlar.env               (paketle kurulumda, tüm kullanıcılar)
#   <program klasörü>/ayarlar.env                (install.sh ile kurulumda)
#   ~/.config/tahta-kumanda/ayarlar.env          (yalnızca o kullanıcı)
# Değişiklikten sonra panelde "Sunucuyu yeniden başlat"a basın.

# Web arayüzü portu (telefondan http://TAHTA_IP:8000)
#TAHTA_PORT=8000

# Tahtadaki klavye düzeni: tr (Türkçe Q) veya us
#TAHTA_KLAVYE=tr

# AirPlay listesinde ve scrcpy penceresinde görünecek ad
#TAHTA_ADI="Akıllı Tahta"

# PIN: ayarlanmazsa ilk açılışta 4 haneli rastgele PIN üretilir ve
# ~/.config/tahta-kumanda/pin dosyasına kaydedilir. "kapali" yazılırsa PIN sorulmaz.
#TAHTA_PIN=

# iPhone (AirPlay) alıcısını aç/kapat: 1 veya 0
#TAHTA_AIRPLAY=1

# Ek UxPlay seçenekleri. Görüntü sorunu olursa deneyin:  -vs ximagesink   ya da  -avdec
#TAHTA_UXPLAY_ARGS=

# Android (scrcpy) görüntü kalitesi: en uzun kenar ve bit hızı
#TAHTA_SCRCPY_BOYUT=1920
#TAHTA_SCRCPY_BITRATE=8M
# Ek scrcpy seçenekleri (ör. --turn-screen-off ile telefon ekranı kapanır)
#TAHTA_SCRCPY_ARGS=

# Telefondan gönderilen dosyaların kaydedileceği klasör (varsayılan: Masaüstü/Telefondan Gelenler)
#TAHTA_DOSYA_KLASORU=
# Tek dosya için üst sınır (MB). Varsayılan: 4096
#TAHTA_DOSYA_LIMIT_MB=4096
# Dosya gelince tahtada bildirim göster: 1 veya 0
#TAHTA_DOSYA_BILDIRIM=1
